{
  "name": "aria-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aria — orchestrateur de sorties (APNs / SendGrid / Twilio). Local-first companion backend.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
