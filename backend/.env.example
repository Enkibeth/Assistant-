# Copier en .env et remplir pour passer du mode dry-run aux envois réels.
# Sans ces variables, le backend valide et journalise sans appeler les fournisseurs.

PORT=8787

# Jeton partagé exigé sur les routes /v1/* (Authorization: Bearer <token>).
# Si vide, l'auth est désactivée (utile en dev local uniquement).
ARIA_API_TOKEN=

# --- APNs (clé .p8 token-based) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.aria
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox   # sandbox | production

# --- SendGrid ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=aria@example.com
SENDGRID_EU_RESIDENCY=false

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_REGION=              # ex. ie1 pour résidence EU
